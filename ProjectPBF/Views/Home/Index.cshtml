@{ ViewData["Title"] = "Strona główna"; }
<section class="gn-dashboard">
    <div class="gn-left">
        <section class="hero-panel">
            <div class="hero-content">
                <span class="eyebrow">PBF • RPG • Kampanie online</span>
                <h1>Twoja przygoda zaczyna się tutaj</h1>
                <p>Twórz postacie, zakładaj kampanie i prowadź sesje Play By Forum. Każda kampania może mieć własne statystyki, pulę punktów i dodatkowy opis postaci.</p>
                <div class="hero-buttons">
                    <a asp-controller="Campaigns" asp-action="Browse" class="btn btn-gn-primary">Dołącz do przygody</a>
                    <a asp-controller="CharacterModels" asp-action="Create" class="btn btn-gn-secondary">Stwórz postać</a>
                </div>
            </div>
        </section>
        <section class="category-grid">
            <a class="category-card" asp-controller="CharacterModels" asp-action="Index"><span class="card-icon">🛡️</span><div><h3>Moje postacie</h3><p>Twórz bohaterów, avatary i ogólne opisy postaci.</p></div></a>
            <a class="category-card" asp-controller="Campaigns" asp-action="Browse"><span class="card-icon">🎲</span><div><h3>Kampanie RPG</h3><p>Każda sesja ma własne statystyki i punkty do rozdania.</p></div></a>
            <a class="category-card" asp-controller="Users" asp-action="Index"><span class="card-icon">🧙</span><div><h3>Społeczność</h3><p>Znajdź graczy, MG i osoby do wspólnej rozgrywki.</p></div></a>
        </section>
        <section class="bottom-panels">
            <div class="gn-panel"><h2>Jak działa kampania?</h2><div class="mini-list"><div><span class="pin">📜</span><strong>MG tworzy sesję</strong><small>ustawia opis i zasady</small></div><div><span class="pin">🎲</span><strong>Wybiera statystyki</strong><small>np. Siła, Mana, Refleks</small></div><div><span class="pin">✨</span><strong>Daje pulę punktów</strong><small>np. 20 punktów do rozdania</small></div></div></div>
            <div class="gn-panel"><h2>Postać w kampanii</h2><p>Postać ma ogólny profil, ale dopiero w konkretnej kampanii dostaje dodatkowy opis, statystyki i wartości zależne od zasad danej gry.</p><a asp-controller="Campaigns" asp-action="Browse">Zobacz kampanie →</a></div>
        </section>
    </div>
    <aside class="gn-sidebar">
        <div class="side-panel"><h3>Ostatnia aktywność</h3><ul class="activity-list"><li><span>⚔️</span><div><strong>Nowa postać</strong><small>Gracz utworzył bohatera</small></div></li><li><span>📜</span><div><strong>Opis kampanii</strong><small>MG dopisał założenia sesji</small></div></li><li><span>👥</span><div><strong>Społeczność</strong><small>Nowi gracze oczekują na akceptację</small></div></li></ul></div>
        <div class="side-panel"><h3>Nadchodzące sesje</h3><div class="event-card"><span class="event-date">20</span><div><strong>Rozdanie punktów</strong><small>Start postaci w kampanii</small></div></div><div class="event-card"><span class="event-date">D20</span><div><strong>Rekrutacja graczy</strong><small>Nowe kampanie PBF</small></div></div></div>
    </aside>
</section>
