@model ProjectPBF.Models.CampaignModel
@{ ViewData["Title"] = Model.Title; }
<section class="page-panel">
    <div class="campaign-details-hero"><div><span class="eyebrow">Kampania</span><h1>@Model.Title</h1><p>@Model.Description</p></div><div class="campaign-owner"><span>MG</span><strong>@Model.GameMaster?.Nick</strong><small>@Model.Status</small><small>Pula punktów: @Model.StartingPoints</small></div></div>
    <div class="details-grid">
        <div class="gn-panel"><h2>Statystyki</h2>@if (Model.Statistics.Any()) { <div class="stat-chip-grid">@foreach (var stat in Model.Statistics) { <span class="stat-chip">✦ @stat.Name <small>@stat.DefaultValue</small></span> }</div> } else { <p>Brak statystyk.</p> }</div>
        <div class="gn-panel"><h2>Uczestnicy</h2>@if (Model.Members.Any()) { <ul class="clean-list">@foreach (var member in Model.Members) { <li><span>👤</span><strong>@member.User?.Nick</strong>@if (member.IsAdmin) { <small>admin sesji</small> }</li> }</ul> } else { <p>Brak uczestników.</p> }</div>
        <div class="gn-panel"><h2>Postacie</h2>@if (Model.CampaignCharacters.Any()) { <ul class="clean-list">@foreach (var item in Model.CampaignCharacters) { <li><span>🛡️</span><strong>@item.Character?.Name</strong><small>@item.Status</small></li> }</ul> } else { <p>Brak postaci przypisanych do kampanii.</p> }</div>
    </div>

    <div class="details-grid mt-3">
        <div class="gn-panel" style="flex:1 1 100%;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2>Sesje</h2>
                @if (ViewBag.CanCreateSession == true)
                {
                    <a asp-controller="Sessions" asp-action="Create" asp-route-campaignId="@Model.Id" class="btn btn-gn-primary">Utwórz sesję</a>
                }
            </div>

            @if (ViewBag.Sessions != null && ((IEnumerable<ProjectPBF.Models.SessionModel>)ViewBag.Sessions).Any())
            {
                @foreach (var session in (IEnumerable<ProjectPBF.Models.SessionModel>)ViewBag.Sessions)
                {
                    <div class="campaign-details-hero mb-2">
                        <div>
                            <span class="eyebrow">Sesja</span>
                            <h3>@session.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(session.Description))
                            {
                                <p class="muted">@session.Description</p>
                            }
                            <a asp-controller="Sessions" asp-action="Details" asp-route-id="@session.Id" class="btn btn-gn-secondary mr-2">Szczegóły</a>
                        </div>
                        <div class="campaign-owner text-right">
                            <span>MG</span>
                            <strong>@session.GameMaster?.Nick</strong>
                            <small>
                                Start: @(session.StartAt.HasValue ? session.StartAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                            </small>
                            <small>
                                Czas: @session.DurationMinutes min
                            </small>
                            <small>
                                @(session.IsPrivate ? "Prywatna" : "Otwarta")
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mb-3">

                        @* Możesz tu dodać dodatkowe akcje (edytuj/usuń) widoczne tylko dla uprawnionych użytkowników *@
                    </div>
                }
            }
            else
            {
                <p>Brak sesji dla tej kampanii.</p>
            }
        </div>
    </div>

    <a asp-action="Browse" class="btn btn-gn-secondary mt-3">Wróć</a>
</section>
