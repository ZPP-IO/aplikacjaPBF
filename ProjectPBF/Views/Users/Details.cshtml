@model ProjectPBF.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "Profil użytkownika";
}

<div class="container py-4">
    <h1 class="mb-4">Profil użytkownika</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.User.AvatarUrl))
                    {
                        <img src="@Model.User.AvatarUrl" alt="Avatar użytkownika" class="img-fluid rounded" style="max-height: 300px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="border rounded p-5 bg-light text-muted">
                            Brak avatara
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <h2>@Model.User.Nick</h2>
                    @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.User.Id.ToString())
                    {
                        <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@Model.User.Id" class="btn btn-sm btn-outline-primary mt-2">
                            Wyślij wiadomość
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-3">Postacie użytkownika</h3>

    @if (!Model.Characters.Any())
    {
        <div class="alert alert-info">
            Ten użytkownik nie ma jeszcze żadnych postaci.
        </div>
    }
    else
    {
        <ul class="list-group">
            @foreach (var character in Model.Characters)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@character.Name</span>
                    <a asp-controller="CharacterModels" asp-action="Details" asp-route-id="@character.Id" class="btn btn-sm btn-outline-primary">
                        Szczegóły
                    </a>
                </li>
            }
        </ul>
    }

    <div class="mt-4">
        <a asp-controller="Users" asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
    </div>
</div>