@model ProjectPBF.Models.CampaignSkillTemplateModel
@using ProjectPBF.Models.Enums
@{
    ViewData["Title"] = "Dodaj skill / technikę";
}
<section class="page-panel narrow">
    <div class="page-heading"><div><span class="eyebrow">Kampania: @ViewBag.CampaignTitle</span><h1>Dodaj skill, technikę albo zaklęcie</h1></div></div>

    <form asp-action="CreateSkill" method="post" class="gn-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CampaignId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Np. Kula ognia, Unik, Kontratak" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Kind" class="form-label"></label>
                <select asp-for="Kind" asp-items="Html.GetEnumSelectList<CampaignSkillTemplateKind>()" class="form-select"></select>
                <span asp-validation-for="Kind" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Cost" class="form-label"></label>
                <input asp-for="Cost" class="form-control" type="number" min="0" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Cooldown" class="form-label"></label>
                <input asp-for="Cooldown" class="form-control" type="number" min="0" />
                <span asp-validation-for="Cooldown" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Requirements" class="form-label"></label>
            <textarea asp-for="Requirements" class="form-control" rows="3" placeholder="Np. klasa Mag, Inteligencja 5, poziom 2"></textarea>
            <span asp-validation-for="Requirements" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Effect" class="form-label"></label>
            <textarea asp-for="Effect" class="form-control" rows="4" placeholder="Opis efektu w mechanice kampanii"></textarea>
            <span asp-validation-for="Effect" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-gn-primary" type="submit">Zapisz skill / technikę</button>
            <a asp-action="Index" asp-route-campaignId="@Model.CampaignId" class="btn btn-gn-secondary">Wróć</a>
        </div>
    </form>
</section>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
