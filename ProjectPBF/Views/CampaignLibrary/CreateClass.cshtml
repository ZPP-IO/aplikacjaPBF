@model IEnumerable<ProjectPBF.Models.ActivityLogModel>

@{
    ViewData["Title"] = "Log aktywności";
}

<div class="container py-4">
    <h1 class="mb-4">Log aktywności</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Brak wpisów w logu aktywności.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Data</th>
                        <th>Użytkownik</th>
                        <th>Akcja</th>
                        <th>Typ encji</th>
                        <th>ID encji</th>
                        <th>Opis</th>
                        <th>Kampania</th>
                        <th>Postać</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(log.User?.Nick ?? "Brak")</td>
                            <td>@log.ActionType</td>
                            <td>@log.EntityType</td>
                            <td>@log.EntityId</td>
                            <td>@log.Description</td>
                            <td>@(log.Campaign?.Title ?? "-")</td>
                            <td>@(log.Character?.Name ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>