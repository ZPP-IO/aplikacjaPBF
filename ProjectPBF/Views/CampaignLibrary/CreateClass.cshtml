@model ProjectPBF.Models.CampaignClassModel
@{
    ViewData["Title"] = "Dodaj klasę";
}
<section class="page-panel narrow">
    <div class="page-heading"><div><span class="eyebrow">Kampania: @ViewBag.CampaignTitle</span><h1>Dodaj klasę postaci</h1></div></div>

    <form asp-action="CreateClass" method="post" class="gn-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CampaignId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Np. Wojownik, Mag, Łotrzyk" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Opis roli, stylu gry i zasad klasy"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MainStatistic" class="form-label"></label>
            <input asp-for="MainStatistic" class="form-control" placeholder="Np. Siła, Inteligencja, Charyzma" />
            <span asp-validation-for="MainStatistic" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="StartingHealth" class="form-label"></label>
                <input asp-for="StartingHealth" class="form-control" type="number" min="0" />
                <span asp-validation-for="StartingHealth" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="StartingResource" class="form-label"></label>
                <input asp-for="StartingResource" class="form-control" type="number" min="0" />
                <span asp-validation-for="StartingResource" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="StartingGold" class="form-label"></label>
                <input asp-for="StartingGold" class="form-control" type="number" min="0" />
                <span asp-validation-for="StartingGold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-gn-primary" type="submit">Zapisz klasę</button>
            <a asp-action="Index" asp-route-campaignId="@Model.CampaignId" class="btn btn-gn-secondary">Wróć</a>
        </div>
    </form>
</section>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
