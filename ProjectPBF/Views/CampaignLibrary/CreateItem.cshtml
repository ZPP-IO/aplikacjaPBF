@model ProjectPBF.Models.CampaignItemTemplateModel
@using ProjectPBF.Models.Enums
@{
    ViewData["Title"] = "Dodaj przedmiot";
}
<section class="page-panel narrow">
    <div class="page-heading"><div><span class="eyebrow">Kampania: @ViewBag.CampaignTitle</span><h1>Dodaj przedmiot / item</h1></div></div>

    <form asp-action="CreateItem" method="post" class="gn-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CampaignId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Np. Zardzewiały miecz, Amulet krwi" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="ItemType" class="form-label"></label>
                <select asp-for="ItemType" asp-items="Html.GetEnumSelectList<CampaignItemType>()" class="form-select"></select>
                <span asp-validation-for="ItemType" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Rarity" class="form-label"></label>
                <input asp-for="Rarity" class="form-control" placeholder="Np. zwykły, rzadki, legendarny" />
                <span asp-validation-for="Rarity" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" min="0" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Effect" class="form-label"></label>
            <textarea asp-for="Effect" class="form-control" rows="4" placeholder="Np. +2 do Siły, raz na sesję pozwala przerzucić test"></textarea>
            <span asp-validation-for="Effect" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-gn-primary" type="submit">Zapisz przedmiot</button>
            <a asp-action="Index" asp-route-campaignId="@Model.CampaignId" class="btn btn-gn-secondary">Wróć</a>
        </div>
    </form>
</section>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
