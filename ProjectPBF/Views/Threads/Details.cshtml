@model ProjectPBF.Models.ForumThreadModel
@using System.Security.Claims
@using ProjectPBF.Models.Enums

@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Administrator") || User.IsInRole("GameMaster");
}

<script>
    function toggleEdit(postId) {
        var form = document.getElementById('edit-form-' + postId);
        var content = document.getElementById('post-content-' + postId);
        if (!form) return;
        if (form.style.display === 'none' || form.style.display === '') {
            form.style.display = 'block';
            if (content) content.style.display = 'none';
        } else {
            form.style.display = 'none';
            if (content) content.style.display = 'block';
        }
    }
    function revealSpoiler(postId) {
        var box = document.getElementById('spoiler-' + postId);
        if (box) box.classList.add('spoiler-revealed');
    }
</script>

<section class="page-panel">
    <div class="page-heading align-items-center">
        <div class="flex-grow-1">
            <span class="eyebrow">Wątek</span>
            <h1 class="mb-0 thread-title-line">
                @if (Model.IsPinned)
                {
                    <span title="Przyklejony">📌</span>
                }
                @Model.Title
                @if (Model.IsArchived)
                {
                    <span class="gn-badge tag-archived">📦 Archiwum</span>
                }
                @if (Model.Tags.HasFlag(ContentTag.Spoiler))
                {
                    <span class="gn-badge tag-spoiler">Spoiler</span>
                }
                @if (Model.Tags.HasFlag(ContentTag.Important))
                {
                    <span class="gn-badge tag-important">Ważne</span>
                }
                @if (Model.Tags.HasFlag(ContentTag.OOC))
                {
                    <span class="gn-badge tag-ooc">OOC</span>
                }
            </h1>
            <p class="text-muted small mb-0">Rozpoczęty: @Model.CreatedAt.ToString("g")</p>
        </div>
        <div class="d-flex gap-2 flex-wrap thread-action-bar">
            @{
                var firstPost = Model.Posts.OrderBy(p => p.CreatedAt).FirstOrDefault();
                var canManage = isAdmin || (firstPost != null && firstPost.UserId == currentUserId);
            }
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">Edytuj tytuł</a>

                @if (!Model.IsArchived)
                {
                    <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Zarchiwizować ten wątek? Nie będzie można dodawać nowych postów.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Archiwizuj</button>
                    </form>
                }
                else if (isAdmin)
                {
                    <form asp-action="Unarchive" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Przywróć z archiwum</button>
                    </form>
                }

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć CAŁY wątek wraz ze wszystkimi postami?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">Usuń wątek</button>
                </form>
            }
            @if (isAdmin)
            {
                <form asp-action="TogglePin" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@(Model.IsPinned ? "Odepnij" : "Przyklej")</button>
                </form>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Reports" asp-action="Create"
                   asp-route-targetType="ForumThread" asp-route-targetId="@Model.Id"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-outline-danger btn-sm">🚩 Zgłoś wątek</a>
            }
            <a asp-action="Index" asp-route-forumId="@Model.ForumId" class="btn btn-outline-secondary btn-sm">Powrót</a>
        </div>
    </div>

    @if (Model.IsArchived)
    {
        <div class="alert alert-dark mt-3 thread-archived-banner">
            📦 Ten wątek jest zarchiwizowany. Dodawanie nowych odpowiedzi jest wyłączone.
        </div>
    }

    <div class="posts-list mt-4">
        @foreach (var p in Model.Posts.OrderBy(p => p.CreatedAt))
        {
            var hasSpoiler = p.Tags.HasFlag(ContentTag.Spoiler);
            <article class="post-card mb-4">
                @* Header posta: Autor i akcje *@
                <div class="post-header p-2 px-3 d-flex justify-content-between align-items-center flex-wrap">
                    <div class="post-info small">
                        <span class="fw-bold post-author-name">@p.AuthorDisplayName</span>
                        @if (!string.IsNullOrEmpty(p.CharacterDisplayName))
                        {
                            <span class="text-muted mx-1">jako</span>
                            <span class="text-info">@p.CharacterDisplayName</span>
                        }
                        <span class="text-muted ms-3 post-date-small">@p.CreatedAt.ToString("g")</span>
                        <div class="post-tag-row">
                            @if (p.Tags.HasFlag(ContentTag.Important))
                            {
                                <span class="gn-badge tag-important">Ważne</span>
                            }
                            @if (p.Tags.HasFlag(ContentTag.OOC))
                            {
                                <span class="gn-badge tag-ooc">OOC</span>
                            }
                            @if (hasSpoiler)
                            {
                                <span class="gn-badge tag-spoiler">Spoiler</span>
                            }
                        </div>
                    </div>

                    <div class="post-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Reports" asp-action="Create"
                               asp-route-targetType="ForumPost" asp-route-targetId="@p.Id"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-link text-danger p-0 m-0 me-2 post-action-link">[ 🚩 Zgłoś ]</a>
                        }
                        @if (isAdmin || p.UserId == currentUserId)
                        {
                            <button type="button" class="btn btn-link text-warning p-0 m-0 me-2 post-action-link" onclick="toggleEdit(@p.Id)">[ Edytuj ]</button>
                            <form asp-action="DeletePost" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Usunąć ten post?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link text-danger p-0 m-0 post-action-link">[ Usuń ]</button>
                            </form>
                        }
                    </div>
                </div>

                @* Treść posta oraz edycja inline (jeśli uprawnienia) *@
                @if (hasSpoiler)
                {
                    <div class="post-body p-3 spoiler-box" id="spoiler-@p.Id">
                        <div class="spoiler-overlay" onclick="revealSpoiler(@p.Id)">⚠️ Kliknij, aby pokazać treść ze spoilerem</div>
                        <div class="spoiler-content" id="post-content-@p.Id">@p.Content</div>
                    </div>
                }
                else
                {
                    <div class="post-body p-3" id="post-content-@p.Id">
                        @p.Content
                    </div>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var canEditThis = isAdmin || p.UserId == currentUserId;
                    if (canEditThis)
                    {
                        <form asp-action="EditPost" method="post" id="edit-form-@p.Id" class="post-edit-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <div class="mb-2">
                                <textarea name="content" class="form-control bg-dark text-white border-secondary" rows="6">@p.Content</textarea>
                            </div>
                            <div class="mb-2 tags-checkbox-group small">
                                <label><input type="checkbox" name="tags" value="Spoiler" @(p.Tags.HasFlag(ContentTag.Spoiler) ? "checked" : "") /> Spoiler</label>
                                <label><input type="checkbox" name="tags" value="Important" @(p.Tags.HasFlag(ContentTag.Important) ? "checked" : "") /> Ważne</label>
                                <label><input type="checkbox" name="tags" value="OOC" @(p.Tags.HasFlag(ContentTag.OOC) ? "checked" : "") /> OOC</label>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-sm btn-primary">Zapisz</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleEdit(@p.Id)">Anuluj</button>
                            </div>
                        </form>
                    }
                }
            </article>
        }
    </div>

    @* Formularz dodawania *@
    @if (Model.IsArchived)
    {
        @* Banner o archiwizacji już wyświetlony wyżej - bez formularza odpowiedzi *@
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <div class="reply-section mt-5 p-4">
            <h3 class="h5 mb-4 text-uppercase reply-section-title">Dodaj odpowiedź</h3>
            <form asp-action="AddPost" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="threadId" value="@Model.Id" />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label small text-muted">Pisz jako postać</label>
                        <select name="characterId" class="form-select bg-dark text-white border-secondary">
                            <option value="">(Użytkownik: @User.Identity.Name)</option>
                            @if (ViewBag.Characters != null)
                            {
                                foreach (var c in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Characters)
                                {
                                    <option value="@c.Value">Postać: @c.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted">Treść wiadomości</label>
                    <textarea name="content" class="form-control bg-dark text-white border-secondary" rows="6" placeholder="Wpisz treść swojej przygody..." required></textarea>
                </div>

                <div class="mb-3 tags-checkbox-group small">
                    <label><input type="checkbox" name="tags" value="Spoiler" /> Spoiler</label>
                    <label><input type="checkbox" name="tags" value="Important" /> Ważne</label>
                    <label><input type="checkbox" name="tags" value="OOC" /> OOC</label>
                </div>

                <div class="text-end">
                    <button class="btn btn-gn-primary px-5" type="submit">Wyślij post</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-dark mt-4 text-center">
            Musisz się zalogować, aby brać udział w dyskusji.
        </div>
    }
</section>