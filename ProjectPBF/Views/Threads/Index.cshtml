@model IEnumerable<ProjectPBF.Models.ForumThreadModel>
@using System.Security.Claims

@{
    var forum = (ProjectPBF.Models.ForumModel)ViewBag.Forum;
    ViewData["Title"] = forum.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<section class="page-panel">
    <div class="page-heading align-items-start">
        <div class="flex-grow-1">
            <span class="eyebrow">Forum</span>
            <h1 class="mb-2">@forum.Name</h1>
            @if (!string.IsNullOrEmpty(forum.Description))
            {
                <p class="text-muted mb-0" style="max-width: 800px; line-height: 1.6;">
                    @forum.Description
                </p>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ms-3">
                <a asp-action="Create" asp-route-forumId="@forum.Id" class="btn btn-gn-primary">Nowy wątek</a>
            </div>
        }
    </div>

    <div class="threads-list mt-4">
        <div class="d-none d-md-flex text-muted small text-uppercase mb-2 px-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <div class="flex-grow-1">Temat</div>
            <div style="width: 100px; text-align: center;">Odpowiedzi</div>
            <div style="width: 250px; padding-left: 15px;">Ostatni post</div>
            <div style="width: 40px;"></div>
        </div>

        @foreach (var t in Model)
        {
            var firstPost = t.Posts?.OrderBy(p => p.CreatedAt).FirstOrDefault();
            var isAuthor = firstPost != null && firstPost.UserId == currentUserId;
            var canDelete = isAuthor || User.IsInRole("Administrator") || User.IsInRole("MistrzGry");

            <article class="forum-card mb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                <div class="forum-card-body p-3 d-flex flex-column flex-md-row align-items-md-center">

                    <div class="forum-meta flex-grow-1 pe-3 mb-3 mb-md-0">
                        <h2 class="forum-title h5 mb-1" style="font-size: 1.15rem;">
                            <a asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none">@t.Title</a>
                        </h2>
                        <p class="text-muted small mb-0">
                            Utworzony: @t.CreatedAt.ToString("g")
                            @if (isAuthor)
                            {
                                <span class="badge bg-dark text-gold ms-1" style="border: 1px solid #e5b869; font-size: 0.7em;">Twój wątek</span>
                            }
                        </p>
                    </div>

                    <div class="forum-stats text-md-center text-muted small" style="width: 100px;">
                        <span class="d-inline d-md-none">Odpowiedzi: </span>
                        <span class="fw-bold" style="color: #e5b869;">@(t.Posts?.Count() ?? 0)</span>
                    </div>

                    <div class="forum-latest mt-2 mt-md-0 pl-md-3 text-truncate" style="width: 250px; padding-left: 15px; border-left: 1px solid rgba(255,255,255,0.1);">
                        @if (t.Posts != null && t.Posts.Any())
                        {
                            var latestPost = t.Posts.OrderByDescending(p => p.CreatedAt).First();
                            <div class="small text-muted">
                                <span>@latestPost.CreatedAt.ToString("g")</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">@t.CreatedAt.ToString("g")</span>
                        }
                    </div>

                    <div class="ms-md-2 text-end" style="width: 40px;">
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@t.Id" method="post" onsubmit="return confirm('Czy na pewno chcesz usunąć ten wątek?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm text-danger opacity-50 hover-opacity-100" style="background:none; border:none; font-size: 1.2rem; line-height: 1;">
                                    &times;
                                </button>
                            </form>
                        }
                    </div>

                </div>
            </article>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span>📝</span>
            <h2>Brak wątków</h2>
            <p>Bądź pierwszą osobą, która rozpocznie dyskusję.</p>
        </div>
    }
</section>