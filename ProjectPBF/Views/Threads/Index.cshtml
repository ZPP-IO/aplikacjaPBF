@model IEnumerable<ProjectPBF.Models.ForumThreadModel>
@using System.Security.Claims
@using ProjectPBF.Models.Enums

@{
    var forum = (ProjectPBF.Models.ForumModel)ViewBag.Forum;
    ViewData["Title"] = forum.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    string? query = ViewBag.Query;
    bool showArchived = ViewBag.ShowArchived ?? false;
}

<section class="page-panel">
    <div class="page-heading align-items-start">
        <div class="flex-grow-1">
            <span class="eyebrow">Forum</span>
            <h1 class="mb-2">@forum.Name</h1>
            @if (!string.IsNullOrEmpty(forum.Description))
            {
                <p class="text-muted mb-0 thread-forum-desc">
                    @forum.Description
                </p>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ms-3">
                <a asp-action="Create" asp-route-forumId="@forum.Id" class="btn btn-gn-primary">Nowy wątek</a>
            </div>
        }
    </div>

    <form method="get" asp-action="Index" class="thread-search-bar mt-3">
        <input type="hidden" name="forumId" value="@forum.Id" />
        <input type="search" name="q" value="@query" class="form-control" placeholder="Szukaj w tytułach i treści wątków..." />
        <div class="form-check thread-search-archive">
            <input type="checkbox" class="form-check-input" id="showArchived" name="showArchived" value="true" @(showArchived ? "checked" : "") />
            <label class="form-check-label small text-muted" for="showArchived">Pokaż zarchiwizowane</label>
        </div>
        <button type="submit" class="btn btn-gn-secondary">Szukaj</button>
    </form>

    <div class="threads-list mt-4">
        <div class="d-none d-md-flex text-muted small text-uppercase mb-2 px-3 pb-2 threads-list-header">
            <div class="flex-grow-1">Temat</div>
            <div class="threads-col-replies">Odpowiedzi</div>
            <div class="threads-col-latest">Ostatni post</div>
            <div class="threads-col-actions"></div>
        </div>

        @foreach (var t in Model)
        {
            var firstPost = t.Posts?.OrderBy(p => p.CreatedAt).FirstOrDefault();
            var isAuthor = firstPost != null && firstPost.UserId == currentUserId;
            var canDelete = isAuthor || User.IsInRole("Administrator") || User.IsInRole("GameMaster");

            <article class="forum-card mb-3 thread-row @(t.IsArchived ? "thread-row-archived" : "")">
                <div class="forum-card-body p-3 d-flex flex-column flex-md-row align-items-md-center">

                    <div class="forum-meta flex-grow-1 pe-3 mb-3 mb-md-0">
                        <h2 class="forum-title h5 mb-1 thread-title-line">
                            @if (t.IsPinned)
                            {
                                <span title="Przyklejony">📌</span>
                            }
                            <a asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none">@t.Title</a>
                            @if (t.IsArchived)
                            {
                                <span class="gn-badge tag-archived" title="Zarchiwizowany">📦 Archiwum</span>
                            }
                            @if (t.Tags.HasFlag(ContentTag.Spoiler))
                            {
                                <span class="gn-badge tag-spoiler">Spoiler</span>
                            }
                            @if (t.Tags.HasFlag(ContentTag.Important))
                            {
                                <span class="gn-badge tag-important">Ważne</span>
                            }
                            @if (t.Tags.HasFlag(ContentTag.OOC))
                            {
                                <span class="gn-badge tag-ooc">OOC</span>
                            }
                        </h2>
                        <p class="text-muted small mb-0">
                            Utworzony: @t.CreatedAt.ToString("g")
                            @if (isAuthor)
                            {
                                <span class="badge bg-dark text-gold ms-1 thread-own-badge">Twój wątek</span>
                            }
                        </p>
                    </div>

                    <div class="forum-stats text-md-center text-muted small threads-col-replies">
                        <span class="d-inline d-md-none">Odpowiedzi: </span>
                        <span class="fw-bold thread-reply-count">@(t.Posts?.Count() ?? 0)</span>
                    </div>

                    <div class="forum-latest mt-2 mt-md-0 text-truncate threads-col-latest">
                        @if (t.Posts != null && t.Posts.Any())
                        {
                            var latestPost = t.Posts.OrderByDescending(p => p.CreatedAt).First();
                            <div class="small text-muted">
                                <span>@latestPost.CreatedAt.ToString("g")</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">@t.CreatedAt.ToString("g")</span>
                        }
                    </div>

                    <div class="ms-md-2 text-end threads-col-actions">
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć ten wątek?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm thread-delete-btn">&times;</button>
                            </form>
                        }
                    </div>

                </div>
            </article>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span>📝</span>
            <h2>Brak wątków</h2>
            <p>@(string.IsNullOrEmpty(query) ? "Bądź pierwszą osobą, która rozpocznie dyskusję." : "Nie znaleziono wątków dla podanej frazy.")</p>
        </div>
    }
</section>