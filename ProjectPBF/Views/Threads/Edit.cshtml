@model ProjectPBF.Models.ForumThreadModel
@{
    ViewData["Title"] = "Edytuj tytuł wątku";
}

<section class="page-panel">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Zarządzanie sesją</span>
            <h1>Edytuj tytuł wątku</h1>
        </div>
    </div>

    <div class="mt-4 card bg-transparent border-secondary">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="forumId" value="@Model.ForumId" />

                <div class="mb-4">
                    <label class="form-label text-muted small">Nowy tytuł wątku</label>
                    <input name="title" value="@Model.Title" class="form-control form-control-lg bg-dark text-white border-secondary" required />
                    <p class="text-muted small mt-2">Pamiętaj o zachowaniu czytelności i ewentualnych tagach sesji (np. [MG], [Prywatne]).</p>
                </div>

                <div class="mb-4 tags-checkbox-group small">
                    <label><input type="checkbox" name="tags" value="Spoiler" @(Model.Tags.HasFlag(ProjectPBF.Models.Enums.ContentTag.Spoiler) ? "checked" : "") /> Spoiler</label>
                    <label><input type="checkbox" name="tags" value="Important" @(Model.Tags.HasFlag(ProjectPBF.Models.Enums.ContentTag.Important) ? "checked" : "") /> Ważne</label>
                    <label><input type="checkbox" name="tags" value="OOC" @(Model.Tags.HasFlag(ProjectPBF.Models.Enums.ContentTag.OOC) ? "checked" : "") /> OOC</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gn-primary px-4">Zaktualizuj tytuł</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Wróć do wątku</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}