@model IEnumerable<ProjectPBF.Models.ForumThreadModel>

@{
    ViewData["Title"] = "Wyszukiwanie";
    string? query = ViewBag.Query;
}

<section class="page-panel">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Forum</span>
            <h1>Wyszukiwanie wątków</h1>
        </div>
    </div>

    <form method="get" asp-action="Search" class="thread-search-bar mt-3">
        <input type="search" name="q" value="@query" class="form-control" placeholder="Szukaj we wszystkich forach..." autofocus />
        <button type="submit" class="btn btn-gn-primary">Szukaj</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(query))
    {
        <p class="text-muted small mt-3">Wyniki dla: "<strong>@query</strong>" (@Model.Count())</p>
    }

    <div class="threads-list mt-4">
        @foreach (var t in Model)
        {
            <article class="forum-card mb-3 thread-row">
                <div class="forum-card-body p-3 d-flex flex-column flex-md-row align-items-md-center">
                    <div class="forum-meta flex-grow-1 pe-3 mb-3 mb-md-0">
                        <p class="text-muted small mb-1">
                            @t.Forum?.Category?.Name <span class="mx-1">›</span> @t.Forum?.Name
                        </p>
                        <h2 class="forum-title h5 mb-1 thread-title-line">
                            <a asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none">@t.Title</a>
                        </h2>
                        <p class="text-muted small mb-0">Utworzony: @t.CreatedAt.ToString("g")</p>
                    </div>
                    <div class="forum-stats text-md-center text-muted small threads-col-replies">
                        <span class="fw-bold thread-reply-count">@(t.Posts?.Count() ?? 0)</span>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(query) && !Model.Any())
    {
        <div class="empty-state">
            <span>🔍</span>
            <h2>Brak wyników</h2>
            <p>Nie znaleziono żadnych wątków dla podanej frazy.</p>
        </div>
    }
</section>