@model ProjectPBF.Models.InventoryItemModel
@using ProjectPBF.Models
@{
    ViewData["Title"] = "Dodaj przedmiot";
    var templates = ViewBag.ItemTemplates as List<CampaignItemTemplateModel> ?? new List<CampaignItemTemplateModel>();
    var selectedTemplateId = ViewBag.SelectedTemplateId as int?;
}

<section class="page-panel narrow">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Postać: @ViewBag.CharacterName | Kampania: @ViewBag.CampaignTitle</span>
            <h1>Dodaj przedmiot do ekwipunku</h1>
            <p>Możesz wybrać item z biblioteki kampanii MG albo wpisać przedmiot ręcznie.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="gn-form">
        @Html.AntiForgeryToken()
        <input asp-for="CharacterId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CampaignItemTemplateId" class="form-label"></label>
            <select asp-for="CampaignItemTemplateId" id="itemTemplateSelect" class="form-control">
                <option value="">Własny przedmiot</option>
                @foreach (var template in templates)
                {
                    <option value="@template.Id"
                            data-name="@template.Name"
                            data-description="@template.Description"
                            data-type="@template.ItemType"
                            data-rarity="@template.Rarity"
                            data-effect="@template.Effect"
                            selected="@(selectedTemplateId == template.Id ? "selected" : null)">
                        @template.Name (@template.ItemType) @(string.IsNullOrWhiteSpace(template.Rarity) ? "" : $"— {template.Rarity}")
                    </option>
                }
            </select>
            <small class="form-text">Biblioteka kampanii to lista przedmiotów przygotowana przez MG.</small>
            <span asp-validation-for="CampaignItemTemplateId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" id="itemName" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="ItemType" class="form-label"></label>
                <input asp-for="ItemType" id="itemType" class="form-control" placeholder="np. broń, pancerz, artefakt" />
                <span asp-validation-for="ItemType" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Rarity" class="form-label"></label>
                <input asp-for="Rarity" id="itemRarity" class="form-control" placeholder="np. zwykły, rzadki" />
                <span asp-validation-for="Rarity" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" max="999" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Effect" class="form-label"></label>
            <textarea asp-for="Effect" id="itemEffect" class="form-control" rows="3" placeholder="Premie, modyfikatory, ograniczenia, użycie w walce/fabule."></textarea>
            <span asp-validation-for="Effect" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" id="itemDescription" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Source" class="form-label"></label>
            <input asp-for="Source" class="form-control" placeholder="np. nagroda za misję, sklep, loot, start klasy" />
            <span asp-validation-for="Source" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsEquipped" class="form-check-input" />
            <label asp-for="IsEquipped" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-gn-primary">Dodaj do ekwipunku</button>
            <a asp-controller="CharacterModels" asp-action="Details" asp-route-id="@Model.CharacterId" class="btn btn-gn-secondary">Wróć</a>
        </div>
    </form>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('itemTemplateSelect')?.addEventListener('change', function () {
            const option = this.options[this.selectedIndex];
            if (!option || !option.value) return;

            document.getElementById('itemName').value = option.dataset.name || '';
            document.getElementById('itemDescription').value = option.dataset.description || '';
            document.getElementById('itemType').value = option.dataset.type || '';
            document.getElementById('itemRarity').value = option.dataset.rarity || '';
            document.getElementById('itemEffect').value = option.dataset.effect || '';
        });
    </script>
}
