@model IEnumerable<ProjectPBF.Models.ForumModel>
@using ProjectPBF.Models.Enums

<h2>Fora</h2>

<p>
    <a class="btn btn-primary" asp-controller="Forums" asp-action="Create">Dodaj forum</a>
</p>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Kategoria</th>
            <th>Nazwa</th>
            <th>Opis</th>
            <th>Poziom dostêpu</th>
            <th>Porz¹dek</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
        {
            <tr>
                <td>@f.Category?.Name</td>
                <td><a asp-controller="Threads" asp-action="Index" asp-route-forumId="@f.Id">@f.Name</a></td>
                <td>@f.Description</td>
                <td>@f.AccessLevel</td>
                <td>@f.Order</td>
                <td>
                    <a class="btn btn-sm btn-secondary" asp-controller="Forums" asp-action="Edit" asp-route-id="@f.Id">Edytuj</a>
                    <a class="btn btn-sm btn-danger" asp-controller="Forums" asp-action="Delete" asp-route-id="@f.Id">Usuñ</a>
                </td>
            </tr>
        }
    </tbody>
</table>
