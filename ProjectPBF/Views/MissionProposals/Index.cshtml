@model IEnumerable<ProjectPBF.Models.MissionProposalModel>
@{
    ViewData["Title"] = "Misje i fabuły";
    var campaignId = ViewBag.CampaignId as int?;
}
<section class="page-panel">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <span class="eyebrow">Fabuła</span>
            <h1>Zgłoszenia misji i fabuł</h1>
            <p class="text-muted">Gracze mogą zgłaszać propozycje misji, a osoby werdyktujące/MG mogą je oceniać.</p>
        </div>
        @if (campaignId.HasValue)
        {
            <a asp-action="Create" asp-route-campaignId="@campaignId.Value" class="btn btn-gn-primary">+ Zgłoś misję</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="gn-panel"><p>Brak zgłoszonych misji lub fabuł.</p></div>
    }
    else
    {
        <div class="details-grid">
            @foreach (var mission in Model)
            {
                var avg = mission.Reviews.Any() ? mission.Reviews.Average(r => r.Score).ToString("0.0") : "—";
                <div class="gn-panel">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <span class="eyebrow">@mission.Campaign?.Title</span>
                            <h2>@mission.Title</h2>
                        </div>
                        <span class="badge bg-info text-dark">@mission.Status</span>
                    </div>
                    <p>@mission.Summary</p>
                    <p class="text-muted">Autor: @mission.SubmittedByUser?.Nick • Oceny: @mission.Reviews.Count • Średnia: @avg</p>
                    <a asp-action="Details" asp-route-id="@mission.Id" class="btn btn-gn-secondary">Szczegóły</a>
                </div>
            }
        </div>
    }
</section>
