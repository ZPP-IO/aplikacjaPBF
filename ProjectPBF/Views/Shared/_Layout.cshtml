<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - System PBF</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectPBF.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="gn-header">
            <nav class="navbar navbar-expand-lg gn-navbar">
                <div class="container-fluid px-4">
                    <a class="navbar-brand gn-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="gn-logo">◆</span><span>System PBF</span></a>
                    <button class="navbar-toggler gn-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"><span class="navbar-toggler-icon"></span></button>
                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav mx-auto gn-menu">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Strona główna</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Campaigns" asp-action="Browse">Kampanie</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Forums">Fora</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="CharacterModels" asp-action="Index">Moje postacie</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Ranking" asp-action="Index">Ranking</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="CalendarEvents" asp-action="Index">Kalendarz</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="MissionProposals" asp-action="Index">Misje</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ConflictRules" asp-action="Index">Zasady</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Społeczność</a></li>

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminPanel" asp-action="Index">Okno admina</a></li>
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="ActivityLogs" asp-action="Index">Log aktywności</a></li>
                            }

                            @if (User.IsInRole("Administrator") || User.IsInRole("GameMaster"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="UserApproval" asp-action="Index">Akceptacja</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="CharacterSkills" asp-action="Pending">Zatwierdzanie umiejętności</a></li>
                            }
                        </ul>
                        <div class="gn-actions"><partial name="_LoginPartial" /></div>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="gn-main">
            @RenderBody()
        </main>

        <footer class="gn-footer">
            <div class="container-fluid px-4">
                <span>&copy; 2026 - System PBF</span>
                <span class="gn-footer-links">
                    <a asp-controller="Home" asp-action="Privacy">Informacje</a>
                    <a asp-controller="Campaigns" asp-action="Browse">Kampanie</a>
                    <a asp-controller="CharacterModels" asp-action="Browse">Postacie</a>
                </span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>