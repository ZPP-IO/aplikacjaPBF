@model ProjectPBF.Models.CharacterModel

@{
    ViewData["Title"] = "Edytuj postać";
}

<div class="container py-4">
    <h1 class="mb-4">Edytuj postać</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Experience" />
                <input type="hidden" asp-for="HistoryPoints" />
                <input type="hidden" asp-for="Level" />
                <input type="hidden" asp-for="AvailableStatisticPoints" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nazwa postaci</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Opis</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AvatarUrl" class="form-label">Link do avatara</label>
                    <input asp-for="AvatarUrl" class="form-control" />
                    <span asp-validation-for="AvatarUrl" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Strength" class="form-label">Siła</label>
                        <input asp-for="Strength" class="form-control" />
                        <span asp-validation-for="Strength" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Agility" class="form-label">Zręczność</label>
                        <input asp-for="Agility" class="form-control" />
                        <span asp-validation-for="Agility" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Intelligence" class="form-label">Inteligencja</label>
                        <input asp-for="Intelligence" class="form-control" />
                        <span asp-validation-for="Intelligence" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <div class="form-group">
                        <label asp-for="Status" class="control-label"></label>
                        <select asp-for="Status" class="form-control"
                                asp-items="Html.GetEnumSelectList<ProjectPBF.Models.Enums.CharacterStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                        Zatwierdzona
                    </label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">Zapisz zmiany</button>
                    <a asp-action="Index" class="btn btn-secondary">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}