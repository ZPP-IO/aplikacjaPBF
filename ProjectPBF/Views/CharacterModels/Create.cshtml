@model ProjectPBF.ViewModels.CharacterCampaignChoiceViewModel
@{
    ViewData["Title"] = "Wybierz kampanię";
}

<section class="page-panel">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Nowa postać</span>
            <h1>Wybierz kampanię</h1>
            <p class="text-muted">Najpierw wybierasz kampanię, bo każda kampania może mieć własny schemat statystyk.</p>
        </div>
        <a asp-controller="Campaigns" asp-action="Browse" class="btn btn-gn-secondary">Przeglądaj kampanie</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    @if (!Model.Campaigns.Any())
    {
        <div class="empty-state">
            <span>📜</span>
            <h2>Brak aktywnych kampanii</h2>
            <p>Nie ma jeszcze kampanii, do której można stworzyć postać.</p>
        </div>
    }
    else
    {
        <div class="campaign-grid">
            @foreach (var campaign in Model.Campaigns)
            {
                <article class="campaign-card">
                    <div class="campaign-medal">🎲</div>
                    <h2>@campaign.Title</h2>
                    <p>@campaign.Description</p>

                    <div class="campaign-meta mb-2">
                        <span>MG: @campaign.GameMasterName</span>
                        <span>Start: @campaign.StartingPoints PK</span>
                        <span>Awans: +@campaign.StatisticPointsPerLevel PK/poziom</span>
                    </div>

                    <p class="text-muted"><strong>Statystyki:</strong> @campaign.StatisticsSummary</p>

                    @if (campaign.IsMember)
                    {
                        <a asp-controller="CharacterModels"
                           asp-action="CreateForCampaign"
                           asp-route-campaignId="@campaign.CampaignId"
                           class="btn btn-gn-primary w-100">
                            Stwórz postać w tej kampanii
                        </a>

                        @if (campaign.HasCharacterInCampaign)
                        {
                            <small class="d-block text-muted mt-2">Masz już postać w tej kampanii, ale możesz stworzyć kolejną, jeśli MG na to pozwala.</small>
                        }
                    }
                    else
                    {
                        <form asp-controller="Campaigns" asp-action="Join" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@campaign.CampaignId" />
                            <input type="hidden" name="createCharacter" value="true" />
                            <button type="submit" class="btn btn-gn-secondary w-100">Dołącz i twórz postać</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>
