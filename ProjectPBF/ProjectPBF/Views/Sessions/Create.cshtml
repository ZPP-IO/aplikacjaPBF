@model ProjectPBF.Models.SessionModel
@{
    ViewData["Title"] = "Utwórz sesjê";
    var campaign = ViewBag.Campaign as ProjectPBF.Models.CampaignModel;
}
<section class="page-panel">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Kampania</span>
            <h1>Utwórz sesjê dla: @campaign?.Title</h1>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="CampaignId" type="hidden" />
        <input asp-for="GameMasterId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Data rozpoczêcia</label>
                <input name="StartDate" type="date" class="form-control" value="@(Model.StartAt.HasValue? Model.StartAt.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="form-group col-md-4">
                <label>Godzina rozpoczêcia</label>
                <input name="StartTime" type="time" class="form-control" value="@(Model.StartAt.HasValue? Model.StartAt.Value.ToString("HH:mm") : "")" />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="DurationMinutes"></label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="0" />
                <small class="form-text text-muted">Czas trwania w minutach</small>
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group form-check">
            <input asp-for="IsPrivate" class="form-check-input" />
            <label asp-for="IsPrivate" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-gn-primary">Utwórz sesjê</button>
        <a asp-action="Index" asp-route-campaignId="@Model.CampaignId" class="btn btn-link">Anuluj</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}