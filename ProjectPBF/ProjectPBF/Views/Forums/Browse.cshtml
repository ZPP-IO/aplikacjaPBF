@model IEnumerable<ProjectPBF.Models.ForumModel>
@{
    ViewData["Title"] = "Fora";
}

<section class="page-panel">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Wydarzenia fabularne</span>
            <h1>Fora</h1>
        </div>
        @if (User.IsInRole("MistrzGry") || User.IsInRole("Administrator"))
        {
            <a asp-controller="Forums" asp-action="Create" class="btn btn-gn-primary">Dodaj forum</a>
        }
    </div>

    <div class="forums-list">
        <div class="d-none d-md-flex text-muted small text-uppercase mb-2 px-3 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <div class="flex-grow-1">Forum</div>
            <div style="width: 100px; text-align: center;">Wątki</div>
            <div style="width: 250px; padding-left: 15px;">Ostatni wątek</div>
            @if (User.IsInRole("Administrator"))
            {
                <div style="width: 50px;"></div>
            }
        </div>

        @foreach (var forum in Model)
        {
            <article class="forum-card mb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                <div class="forum-card-body p-3 d-flex flex-column flex-md-row align-items-md-center">

                    <div class="forum-meta flex-grow-1 pe-3 mb-3 mb-md-0">
                        <h2 class="forum-title h5 mb-1" style="font-size: 1.25rem;">
                            <a asp-controller="Threads" asp-action="Index" asp-route-forumId="@forum.Id" class="text-decoration-none">@forum.Name</a>
                        </h2>
                        <p class="text-muted small mb-0">@forum.Description</p>
                    </div>

                    <div class="forum-stats text-md-center text-muted small" style="width: 100px;">
                        <span class="d-inline d-md-none">Liczba wątków: </span>
                        <span class="fw-bold" style="color: #e5b869;">@(forum.Threads?.Count() ?? 0)</span>
                    </div>

                    <div class="forum-latest mt-2 mt-md-0 pl-md-3" style="width: 250px; padding-left: 15px; border-left: 1px solid rgba(255,255,255,0.1);">
                        @if (forum.Threads != null && forum.Threads.Any())
                        {
                            var latestThread = forum.Threads.OrderByDescending(t => t.CreatedAt).First();
                            <div class="small">
                                <a asp-controller="Threads" asp-action="Details" asp-route-id="@latestThread.Id" class="d-block text-truncate text-decoration-none" style="max-width: 230px;" title="@latestThread.Title">@latestThread.Title</a>
                                <span class="text-muted" style="font-size: 0.85em;">@latestThread.CreatedAt.ToString("g")</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">Brak wątków</span>
                        }
                    </div>

                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="ms-md-3 mt-2 mt-md-0 text-end" style="width: 50px;">
                            <a asp-action="Edit" asp-route-id="@forum.Id" class="btn btn-sm btn-outline-warning" title="Edytuj forum">✎</a>
                            <form asp-action="Delete" asp-route-id="@forum.Id" method="post" onsubmit="return confirm('UWAGA: Usunięcie forum usunie wszystkie zawarte w nim wątki i posty. Kontynuować?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń forum">
                                    &times;
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><span>💬</span><h2>Brak forów</h2><p>Dodaj pierwsze forum.</p></div>
    }
</section>