@model ProjectPBF.Models.ForumModel
@using ProjectPBF.Models.Enums

<h2>Edytuj forum</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Kategoria</label>
        <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Nazwa</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Opis</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Poziom dostêpu</label>
        <select asp-for="AccessLevel" class="form-select">
            @foreach (var v in (Array)ViewBag.AccessLevels)
            {
                var intVal = (int)v;
                var selected = Model.AccessLevel == (ProjectPBF.Models.Enums.ForumAccessLevel)v ? "selected" : string.Empty;
                <option value="@intVal" selected="@selected">@v</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Porz¹dek</label>
        <input asp-for="Order" class="form-control" type="number" />
    </div>
    <button class="btn btn-success" type="submit">Zapisz</button>
    <a class="btn btn-secondary" asp-controller="Forums" asp-action="Index">Anuluj</a>
</form>
